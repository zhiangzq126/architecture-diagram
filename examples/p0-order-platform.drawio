<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="architecture-diagram" compressed="false">
  <diagram name="订单平台与异步履约" id="platform">
    <mxGraphModel grid="1" page="1" pageWidth="1340" pageHeight="850" background="#FFFFFF">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="订单平台与异步履约" style="text;html=1;fontSize=26;fontStyle=1;align=left;fontColor=#172B4D" vertex="1" parent="1"><mxGeometry x="20" y="30" width="1200" height="40" as="geometry"/></mxCell>
        <mxCell id="access-zone" value="接入安全域" style="rounded=1;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacingTop=12;spacingLeft=16;fillColor=#F5F8FC;strokeColor=#A8BCD3;fontColor=#172B4D;fontSize=16" vertex="1" parent="1"><mxGeometry x="20" y="100" width="610" height="180" as="geometry"/></mxCell>
        <mxCell id="service-zone" value="交易与履约服务域" style="rounded=1;arcSize=4;html=1;verticalAlign=top;align=left;spacingTop=12;spacingLeft=16;fillColor=#F6FBF8;strokeColor=#97B9A7;fontColor=#172B4D;fontSize=16" vertex="1" parent="1"><mxGeometry x="680" y="100" width="620" height="700" as="geometry"/></mxCell>
        <mxCell id="storage-zone" value="履约与存储分区" style="rounded=1;html=1;verticalAlign=top;align=left;spacingTop=10;spacingLeft=12;fillColor=#EDF7F1;strokeColor=#A8C4B4;fontColor=#172B4D;fontSize=14;dashed=1" vertex="1" parent="service-zone"><mxGeometry x="330" y="40" width="280" height="640" as="geometry"/></mxCell>
        <mxCell id="portal" value="商家运营工作台&lt;br&gt;订单查询与履约管理" style="rounded=1;html=1;whiteSpace=wrap;fontSize=17;fontColor=#172B4D;fillColor=#E8F1FF;strokeColor=#5B7FA5" vertex="1" parent="access-zone"><mxGeometry x="20" y="60" width="240" height="84" as="geometry"/></mxCell>
        <mxCell id="gateway" value="统一身份认证网关&lt;br&gt;身份校验与请求限流" style="rounded=1;html=1;whiteSpace=wrap;fontSize=17;fontColor=#172B4D;fillColor=#FFF2CC;strokeColor=#B49B48" vertex="1" parent="access-zone"><mxGeometry x="350" y="60" width="240" height="84" as="geometry"/></mxCell>
        <mxCell id="orders" value="订单交易协调服务&lt;br&gt;幂等提交与库存预占" style="rounded=1;html=1;whiteSpace=wrap;fontSize=17;fontColor=#172B4D;fillColor=#E8F1FF;strokeColor=#5B7FA5" vertex="1" parent="service-zone"><mxGeometry x="20" y="60" width="240" height="84" as="geometry"/></mxCell>
        <mxCell id="primary" value="订单主数据存储&lt;br&gt;MySQL · 事务记录" style="rounded=1;html=1;whiteSpace=wrap;spacingRight=44;fontSize=17;fontColor=#172B4D;fillColor=#DFF3E8;strokeColor=#40866B" vertex="1" parent="storage-zone"><mxGeometry x="20" y="40" width="240" height="84" as="geometry"/></mxCell>
        <mxCell id="events" value="订单领域事件队列&lt;br&gt;异步投递与消费重试" style="rounded=1;html=1;whiteSpace=wrap;fontSize=17;fontColor=#172B4D;fillColor=#EDE5F6;strokeColor=#9673A6" vertex="1" parent="service-zone"><mxGeometry x="20" y="320" width="240" height="84" as="geometry"/></mxCell>
        <mxCell id="fulfillment" value="跨仓履约编排服务&lt;br&gt;拆单与配送状态汇总" style="rounded=1;html=1;whiteSpace=wrap;fontSize=17;fontColor=#172B4D;fillColor=#E8F1FF;strokeColor=#5B7FA5" vertex="1" parent="storage-zone"><mxGeometry x="20" y="280" width="240" height="84" as="geometry"/></mxCell>
        <mxCell id="archive" value="履约审计记录存储&lt;br&gt;MySQL · 独立业务身份" style="rounded=1;html=1;whiteSpace=wrap;spacingRight=44;fontSize=17;fontColor=#172B4D;fillColor=#DFF3E8;strokeColor=#40866B" vertex="1" parent="storage-zone"><mxGeometry x="20" y="540" width="240" height="84" as="geometry"/></mxCell>
        <mxCell id="portal-gateway" value="HTTPS" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=14;strokeColor=#5B7FA5;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5" edge="1" parent="1" source="portal" target="gateway"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="325" y="202"/></Array></mxGeometry></mxCell>
        <mxCell id="gateway-orders" value="鉴权请求" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=14;strokeColor=#5B7FA5;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5" edge="1" parent="1" source="gateway" target="orders"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="655" y="202"/></Array></mxGeometry></mxCell>
        <mxCell id="orders-primary" value="事务提交" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=14;strokeColor=#40866B;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5" edge="1" parent="1" source="orders" target="primary"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="980" y="202"/><mxPoint x="980" y="222"/></Array></mxGeometry></mxCell>
        <mxCell id="orders-events" value="领域事件" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=14;strokeColor=#9673A6;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0" edge="1" parent="1" source="orders" target="events"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="820" y="330"/></Array><mxPoint x="42" y="0" as="offset"/></mxGeometry></mxCell>
        <mxCell id="events-fulfillment" value="消费确认" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=14;strokeColor=#9673A6;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5" edge="1" parent="1" source="events" target="fulfillment"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="985" y="462"/></Array></mxGeometry></mxCell>
        <mxCell id="fulfillment-archive" value="审计写入" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=14;strokeColor=#40866B;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0" edge="1" parent="1" source="fulfillment" target="archive"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1150" y="590"/></Array><mxPoint x="42" y="0" as="offset"/></mxGeometry></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="履约重试与人工补偿" id="retry">
    <mxGraphModel grid="1" page="1" pageWidth="1300" pageHeight="620" background="#FFFFFF">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="retry-title" value="履约重试与人工补偿" style="text;html=1;fontSize=26;fontStyle=1;align=left;fontColor=#172B4D" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1200" height="40" as="geometry"/></mxCell>
        <mxCell id="receive" value="接收订单领域事件&lt;br&gt;保留原始业务标识" style="rounded=1;html=1;whiteSpace=wrap;fontSize=17;fillColor=#E8F1FF;strokeColor=#5B7FA5;fontColor=#172B4D" vertex="1" parent="1"><mxGeometry x="40" y="150" width="220" height="84" as="geometry"/></mxCell>
        <mxCell id="validate" value="校验幂等与业务状态&lt;br&gt;过滤重复消费请求" style="rounded=1;html=1;whiteSpace=wrap;fontSize=17;fillColor=#FFF2CC;strokeColor=#B49B48;fontColor=#172B4D" vertex="1" parent="1"><mxGeometry x="360" y="150" width="220" height="84" as="geometry"/></mxCell>
        <mxCell id="apply" value="执行跨仓履约操作&lt;br&gt;支持重试再次进入" style="rounded=1;html=1;whiteSpace=wrap;fontSize=17;fillColor=#E8F1FF;strokeColor=#5B7FA5;fontColor=#172B4D" vertex="1" parent="1"><mxGeometry x="680" y="150" width="220" height="84" as="geometry"/></mxCell>
        <mxCell id="commit" value="持久化履约结果&lt;br&gt;MySQL · 消费确认" style="rounded=1;html=1;whiteSpace=wrap;fontSize=17;spacingRight=44;fillColor=#DFF3E8;strokeColor=#40866B;fontColor=#172B4D" vertex="1" parent="1"><mxGeometry x="1000" y="150" width="240" height="84" as="geometry"/></mxCell>
        <mxCell id="retry-delay" value="记录可恢复异常&lt;br&gt;延迟队列等待重试" style="rounded=1;html=1;whiteSpace=wrap;fontSize=17;fillColor=#FFE6CC;strokeColor=#D79B00;fontColor=#172B4D" vertex="1" parent="1"><mxGeometry x="360" y="410" width="220" height="84" as="geometry"/></mxCell>
        <mxCell id="replay" value="检查重试次数上限&lt;br&gt;最多三次自动重试" style="rounded=1;html=1;whiteSpace=wrap;fontSize=17;fillColor=#FFF2CC;strokeColor=#B49B48;fontColor=#172B4D" vertex="1" parent="1"><mxGeometry x="680" y="410" width="220" height="84" as="geometry"/></mxCell>
        <mxCell id="manual" value="人工核查与补偿&lt;br&gt;保留节点等待处理" style="rounded=1;html=1;whiteSpace=wrap;fontSize=17;fillColor=#F8CECC;strokeColor=#B85450;fontColor=#172B4D" vertex="1" parent="1"><mxGeometry x="1000" y="410" width="240" height="84" as="geometry"/></mxCell>
        <mxCell id="receive-validate" value="领域事件" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;labelBackgroundColor=#FFFFFF;fontSize=14;exitX=1;exitY=0.5;entryX=0;entryY=0.5" edge="1" parent="1" source="receive" target="validate"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="310" y="192"/></Array></mxGeometry></mxCell>
        <mxCell id="validate-apply" value="校验通过" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;labelBackgroundColor=#FFFFFF;fontSize=14;exitX=1;exitY=0.5;entryX=0;entryY=0.5" edge="1" parent="1" source="validate" target="apply"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="630" y="192"/></Array></mxGeometry></mxCell>
        <mxCell id="apply-commit" value="履约成功" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;labelBackgroundColor=#FFFFFF;fontSize=14;exitX=1;exitY=0.5;entryX=0;entryY=0.5" edge="1" parent="1" source="apply" target="commit"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="950" y="192"/></Array></mxGeometry></mxCell>
        <mxCell id="validate-delay" value="状态暂不可用" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;labelBackgroundColor=#FFFFFF;fontSize=14;exitX=0.5;exitY=1;entryX=0.5;entryY=0" edge="1" parent="1" source="validate" target="retry-delay"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="470" y="320"/></Array><mxPoint x="55" y="0" as="offset"/></mxGeometry></mxCell>
        <mxCell id="delay-replay" value="延迟到期" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;labelBackgroundColor=#FFFFFF;fontSize=14;exitX=1;exitY=0.5;entryX=0;entryY=0.5" edge="1" parent="1" source="retry-delay" target="replay"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="630" y="452"/></Array></mxGeometry></mxCell>
        <mxCell id="replay-apply" value="未达上限" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;labelBackgroundColor=#FFFFFF;fontSize=14;exitX=0.5;exitY=0;entryX=0.5;entryY=1" edge="1" parent="1" source="replay" target="apply"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="790" y="320"/></Array><mxPoint x="42" y="0" as="offset"/></mxGeometry></mxCell>
        <mxCell id="replay-manual" value="重试耗尽" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;labelBackgroundColor=#FFFFFF;fontSize=14;exitX=1;exitY=0.5;entryX=0;entryY=0.5" edge="1" parent="1" source="replay" target="manual"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="950" y="452"/></Array></mxGeometry></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
